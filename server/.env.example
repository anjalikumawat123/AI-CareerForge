# Server environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Port the Express server listens on (Render sets this automatically)
PORT=5000

# Comma-separated list of allowed frontend origins
# Local:      http://localhost:5173
# Production: https://ai-careerforge.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# Path to the SQLite database file (relative to server/)
DB_PATH=data/careerforge.db

# REQUIRED: long random string, keep secret
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Directory for locally stored resume files (relative to server/)
UPLOAD_DIR=uploads

# Maximum allowed resume file size in megabytes
MAX_FILE_SIZE_MB=5

# IBM watsonx.ai (leave all blank to use the built-in local analysis engine)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
